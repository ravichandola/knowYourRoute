# ==========================================
# Know Your Route - Environment Configuration
# ==========================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env

# ── App ──────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ── Mobile (Expo) ────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_ENABLE_MOCKS=true
EXPO_NO_TELEMETRY=1

# ── Persistence ──────────────────────────
# 'prisma' (PostgreSQL) or 'memory' (in-memory, for unit tests)
PERSISTENCE_DRIVER=prisma

# ── Database (PostgreSQL) ────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/know_your_route?schema=public"

# ── Redis ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ───────────────────
JWT_SECRET=dev-jwt-secret-know-your-route-2026-auth-token-key
JWT_EXPIRES_IN=7d
JWT_ISSUER=know-your-route
JWT_AUDIENCE=know-your-route

# ── CORS ─────────────────────────────────
# Comma-separated origins. Omit for dev defaults (localhost).
# CORS_ORIGINS=https://example.com,https://app.example.com

# ── Object Storage (S3 / MinIO) ─────────
STORAGE_ENABLED=false
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=know-your-route-assets
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=ap-south-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_SIGNED_URL_TTL_SECONDS=900

# ── Provider Modes ───────────────────────
# Only 'mock' is implemented; unknown values fail at boot.
MAP_PROVIDER=mock
WEATHER_PROVIDER=mock
VEHICLE_PROVIDER=mock
FASTAG_PROVIDER=mock
AI_PROVIDER=mock

# ── External Provider Credentials ────────
GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Logging ──────────────────────────────
# debug | info | warn | error (default: debug in dev, info in production)
# LOG_LEVEL=debug

# ── HTTP Limits ──────────────────────────
BODY_LIMIT=1mb
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
# ── Swagger ──────────────────────────────
# Swagger is auto-enabled in dev; set to true to enable in production
ENABLE_SWAGGER=false
