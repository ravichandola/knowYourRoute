{
  "name": "@know-your-route/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for the wire contract: domain types, zod schemas and HTTP endpoint definitions shared by the API and every client.",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.7.2"
  },
  "react-native": "./src/index.ts",
  "browser": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ]
}
