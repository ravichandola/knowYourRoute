# ==========================================
# Know Your Route - Environment Configuration
# ==========================================

# Node / Environment
NODE_ENV=development
PORT=4000

# Backend API URL (for mobile client)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_ENABLE_MOCKS=true

# Persistence driver: 'memory' (demo data, no DB needed) | 'prisma' (PostgreSQL via DATABASE_URL)
PERSISTENCE_DRIVER=memory

# Database (PostgreSQL) - used only when PERSISTENCE_DRIVER=prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/know_your_route?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=supersecret-dev-jwt-key-replace-in-production-min32chars
JWT_EXPIRES_IN=7d

# Provider Modes (only 'mock' is implemented today; unknown values fail at boot)
MAP_PROVIDER=mock
WEATHER_PROVIDER=mock
VEHICLE_PROVIDER=mock
FASTAG_PROVIDER=mock
AI_PROVIDER=mock

# External Provider Credentials (Backend only - never in mobile!)
GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Object Storage (S3 / MinIO)
STORAGE_ENDPOINT=
STORAGE_BUCKET=know-your-route-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-south-1
