# Isolated test configuration. Copy to .env.test (gitignored) if you run DB-backed tests locally.
# The database name MUST contain "test": env validation refuses anything else when NODE_ENV=test.
NODE_ENV=test
PORT=4001

PERSISTENCE_DRIVER=prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/know_your_route_test?schema=public"

# Use a different Redis logical DB than development (0).
REDIS_URL=redis://localhost:6379/1

JWT_SECRET=test-jwt-secret-not-for-production-use-0123456789
JWT_ISSUER=know-your-route
JWT_AUDIENCE=know-your-route

STORAGE_ENABLED=false
